{
    "_version": "1.21.0",
    "sap.app": {
        "id": "analytics",
        "type": "application",
        "title": "Sales Analytics Dashboard",
        "applicationVersion": {
            "version": "1.0.0"
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "analytics.view.App",
            "type": "XML",
            "id": "app",
            "async": true
        },
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.viz": {},
                "sap.f": {}
            }
        },
        "models": {
            "": {
                "type": "sap.ui.model.json.JSONModel",
                "uri": "model/data.json"
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "analytics.i18n.i18n"
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "analytics.view",
                "controlId": "appControl",
                "controlAggregation": "pages"
            },
            "routes": [
                {
                    "name": "dashboard",
                    "pattern": "",
                    "target": "dashboard"
                }
            ],
            "targets": {
                "dashboard": {
                    "name": "Dashboard",
                    "id": "dashboard"
                }
            }
        }
    }
}
